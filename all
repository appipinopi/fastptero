#!/bin/bash
# fastptero.se — ALL OS (20.04/22.04/24.04 auto-detect)
set -euo pipefail
log(){ echo "[$(printf "%02ds" $SECONDS)] $1"; }
fail(){ echo "[$(printf "%02ds" $SECONDS)] ❌ $1"; exit 1; }
quiet(){ "$@" >/dev/null 2>&1; }

log "🚀 fastptero.se (all) started"
ID=$(grep "^ID=" /etc/os-release | cut -d= -f2)
VER=$(grep "^VERSION_ID=" /etc/os-release | cut -d= -f2 | tr -d '"')
[[ "$ID" != "ubuntu" ]] && fail "Ubuntu only"
[[ "$VER" != "20.04" && "$VER" != "22.04" && "$VER" != "24.04" ]] && fail "Only 20/22/24 supported"

read -rp "[?] Mode [i/d]: " M; [[ "$M" != "i" && "$M" != "d" ]] && fail "i/d only"
read -rp "[?] Fresh LTS? (y/N): " F; [[ "$F" != "y" ]] && fail "fresh required"

[[ "$M" == "d" ]] && {
  quiet systemctl stop wings pterodactyl-queue nginx 2>/dev/null || true
  quiet apt remove -y nginx redis-server php* mariadb-server 2>/dev/null || true
  rm -rf /etc/pterodactyl /var/lib/pterodactyl /var/www/pterodactyl /usr/local/bin/wings
  mysql -e "DROP DATABASE IF EXISTS panel; DROP USER IF EXISTS 'pterodactyl'@'127.0.0.1';" 2>/dev/null || true
  log "✔ Deinstall done"; exit 0
}

read -rp "[?] Domain [xxxx.xx]: " D; [[ -z "$D" ]] && fail "need domain"
PANEL="panel.$D"; NODE="node.$D"
read -rp "[?] Email [admin@$D]: " E; E="${E:-admin@$D}"

P=$(tr -dc A-HJ-NP-Za-km-z2-9 </dev/urandom|head -c16)
DBP=$(tr -dc A-HJ-NP-Za-km-z2-9 </dev/urandom|head -c24)

export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a
quiet apt update -y; quiet apt install -y curl ufw
quiet ufw --force reset; quiet ufw default deny incoming; quiet ufw default allow outgoing
quiet ufw allow 22,80,443,2022,8080,3306/tcp; quiet ufw --force enable

# 24.04: fix resolv.conf
[[ "$VER" == "24.04" ]] && { quiet systemctl stop systemd-resolved; echo "nameserver 8.8.8.8" > /etc/resolv.conf; }

log "⏳ Panel → $PANEL ..."
quiet curl -sSL https://get.pterodactyl.io/panel/install.sh | bash -s -- \
  --email "$E" --name admin --password "$P" --first-name admin --last-name admin \
  --domain "$PANEL" --dbpass "$DBP" --lets-encrypt --agree-lets-encrypt "$E" \
  --skip-interactive --auto-configure-ufw

log "⏳ Wings → $NODE ..."
quiet curl -sSL https://get.pterodactyl.io/wings/install.sh | bash -s -- \
  --panel-url "https://$PANEL" --auto

U=$(mysql -sN -e "SELECT uuid FROM panel.users WHERE email='$E';" panel 2>/dev/null || echo "N/A")
L=$(hostname -I|awk '{print $1}'); G=$(curl -s4m3 ifconfig.me 2>/dev/null||echo "N/A")

echo; echo "---admin---"; echo "UUID: $U"; echo "username: admin"
echo "F/L: admin admin"; echo "password: $P"; echo "--------------"
echo "---URL---"; echo "local:      http://$L"; echo "global:     http://$G"
echo "domain:     https://$PANEL"; echo "--------------"

read -rp "[?] Enable auto-start? (y/N): " A
[[ "$A" == "y" ]] && { quiet systemctl enable wings pterodactyl-queue; log "✅ Auto-start enabled"; }
log "🎉 All done! ($SECONDS s)"
